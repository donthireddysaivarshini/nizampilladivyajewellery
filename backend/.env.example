# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/staffarc

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-min-24-chars
JWT_REFRESH_SECRET=change-me-min-24-chars
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# ── Payments ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OAuth ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Email notifications ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Sai Nakshatra Collections
MAIL_ADMIN_RECIPIENTS=
MAIL_NOTIFICATIONS_ENABLED=true

# ── Upload pipeline ───────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=100
IMAGE_MAX_DIMENSION=2200
IMAGE_QUALITY=85

# ── Backblaze B2 media storage (S3-compatible) ────────────────────────────
# Leave blank to keep storing uploads on the local disk (backend/uploads).
# B2_PUBLIC_URL is the public origin that serves the files, e.g.
# https://your-bucket.s3.us-west-000.backblazeb2.com (or your custom domain/CDN).
B2_ENDPOINT=
B2_REGION=us-west-000
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PUBLIC_URL=
