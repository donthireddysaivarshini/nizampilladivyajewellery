# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/staffarc

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-min-24-chars
JWT_REFRESH_SECRET=change-me-min-24-chars
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# ── Payments ──────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── OAuth ─────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Upload pipeline ───────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=100
IMAGE_MAX_DIMENSION=2200
IMAGE_QUALITY=85

